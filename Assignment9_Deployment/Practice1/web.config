<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="practice_1_multi_environment_deployment.js" verb="*" modules="iisnode"/>
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeJS">
          <match url=".*" />
          <action type="Rewrite" url="practice_1_multi_environment_deployment.js" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>